## Texture that draws only the visible rect but keeps the full size,
## so it lines up exactly like the original.
static func cropped(name: String, tex: Texture2D) -> Texture2D:
	if not RECTS.has(name):
		return tex
	var r: Rect2 = RECTS[name]
	var at := AtlasTexture.new()
	at.atlas = tex
	at.region = r
	at.margin = Rect2(r.position, tex.get_size() - r.size)
	at.filter_clip = true
	return at
